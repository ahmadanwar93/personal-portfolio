---
import '../styles/press.css';

interface Props { title: string; description?: string; running?: string }
const {
  title,
  description = 'Small things for the web, designed and built by Fikri, each with an honest account of how it was made.',
  running,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// link previews need absolute URLs, so build them from `site` + `base`
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f1ed" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- link previews: Open Graph (most chat apps) and Twitter/X -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fikri · A Playground" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="An engraved blue flower above the name Fikri, printed on paper." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <!-- the press: rough the edges of inked shapes the way a real impression does -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="press" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="head">
      <a class="home sc" href={`${base}/`}>Fikri</a>
      {running && <span class="running sc" aria-hidden="true">{running}</span>}
      <nav aria-label="Main">
        <a class="sc" href={`${base}/#contents`}>Contents</a>
        <a class="sc" href={`${base}/#colophon`}>Colophon</a>
        <a class="sc" href="https://github.com/ahmadanwar93" rel="me noopener">GitHub</a>
      </nav>
    </header>

    <slot />

    <footer class="foot">
      <hr class="rule" />
      <p class="sc">Fikri · {new Date().getFullYear()}</p>
      <a class="sc" href={`${base}/specimens/`}>Specimens</a>
    </footer>
  </body>
</html>

<style>
  .head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 16px;
    padding: clamp(18px, 3vw, 32px) var(--gutter) 0;
    font-size: 1rem;
  }
  .home { justify-self: start; text-decoration: none; letter-spacing: 0.22em; font-size: 1.0625rem; }
  .running { color: var(--ink-3); letter-spacing: 0.16em; }
  nav { grid-column: 3; justify-self: end; display: flex; gap: clamp(14px, 2.4vw, 32px); }
  nav a { text-decoration: none; letter-spacing: 0.16em; }
  nav a:hover { color: var(--rubric); }

  .foot {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    row-gap: 14px;
    max-width: 980px;
    margin: clamp(96px, 14vw, 180px) auto 0;
    padding: 0 var(--gutter) clamp(28px, 4vw, 48px);
    font-size: 0.9375rem;
    color: var(--ink-3);
  }
  .foot .rule { grid-column: 1 / -1; border-color: var(--ink-3); }
  .foot p { margin: 0; }
  .foot a { text-decoration: none; letter-spacing: 0.12em; }

  @media (max-width: 640px) {
    .head { grid-template-columns: auto 1fr; }
    .running { display: none; }
    nav { grid-column: 2; gap: 14px; font-size: 0.9375rem; }
  }
</style>
