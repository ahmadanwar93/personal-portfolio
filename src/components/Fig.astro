---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  n: number;
  src: ImageMetadata;
  alt: string;
  /** wide breaks out of the reading column; square sits in the margin on wide screens */
  size?: 'column' | 'wide' | 'square';
}
const { n, src, alt, size = 'column' } = Astro.props;
---
<figure class:list={['fig', `fig--${size}`]} id={`fig-${n}`} data-fig={n}>
  <div class="frame">
    <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={size === 'wide' ? '(min-width: 1100px) 1000px, 100vw' : '(min-width: 760px) 680px, 100vw'} />
  </div>
  <figcaption><span class="caps fig-n">Fig. {n}</span> <slot /></figcaption>
</figure>
